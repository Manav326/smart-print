# One canonical public HTTPS URL for portal, QR links, API pairing and Agent.
PUBLIC_BASE_URL=

# Cloudflare Tunnel credentials are centrally managed by QuantaEdge-Production.
# Publish this hostname to http://smart-print-portal:80 on the shared cloudflare-edge network.
IMAGE_NAMESPACE=ghcr.io/manav326
# Derived from the deployment repository's Git origin; used only for release asset lookup.
GITHUB_REPOSITORY=Manav326/smart-print
IMAGE_TAG=latest
POSTGRES_DB=qrtoprint
POSTGRES_USER=qrtoprint
POSTGRES_PASSWORD=CHANGE_ME
AUTH_SIGNING_KEY=CHANGE_ME
DOCUMENTS_ENCRYPTION_KEY=CHANGE_ME

# Optional Razorpay Standard Checkout credentials for shop subscription billing.
# Keep API secrets and the webhook secret server-side; never put them in portal build variables.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
