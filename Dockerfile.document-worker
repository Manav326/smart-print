FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG SOURCE_REPOSITORY=
LABEL org.opencontainers.image.source="${SOURCE_REPOSITORY}"
LABEL org.opencontainers.image.description="Isolated SmartPrint document parser worker"
WORKDIR /source
COPY . .
RUN dotnet restore src/SmartPrint.DocumentWorker/SmartPrint.DocumentWorker.csproj
RUN dotnet publish src/SmartPrint.DocumentWorker/SmartPrint.DocumentWorker.csproj \
    --configuration Release \
    --no-restore \
    --output /app/publish \
    /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build --chown=app:app /app/publish/ ./
ENV ASPNETCORE_URLS=http://+:8090
EXPOSE 8090
USER app
ENTRYPOINT ["dotnet", "SmartPrint.DocumentWorker.dll"]
